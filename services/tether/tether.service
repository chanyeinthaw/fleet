# Managed by Fleet: tether
[Unit]
Description=Tether Wi-Fi connection monitor and fallback recovery
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/bin/tether
Environment=XDG_CONFIG_HOME=%h/.config
Environment=XDG_STATE_HOME=%h/.local/state
Restart=on-failure
RestartSec=15s
TimeoutStopSec=25s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET
LockPersonality=yes

[Install]
WantedBy=default.target
