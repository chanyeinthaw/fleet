#!/usr/bin/env python3
"""Reconcile the opted-in Tether user service during bootstrap and update."""

import hashlib
import json
import os
from pathlib import Path
import platform
import pwd
import subprocess
import sys
import tempfile
import urllib.request

REPO = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO / "scripts/agents"))
from fleet_config import read_config

MARKER = "# Managed by Fleet: tether"


def digest(data):
    return hashlib.sha256(data).hexdigest()


def command(args):
    result = subprocess.run(args, capture_output=True, text=True)
    if result.returncode:
        raise RuntimeError(f"{args[0]} failed: {result.stderr.strip()}")
    return result.stdout.strip()


def systemctl(*args):
    return command(["systemctl", "--user", *args])


def atomic_write(path, data, mode):
    if path.exists() and path.read_bytes() == data:
        path.chmod(mode)
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as file:
            file.write(data)
        os.chmod(name, mode)
        os.replace(name, path)
    finally:
        Path(name).unlink(missing_ok=True)
    return True


def download(url, checksum):
    request = urllib.request.Request(url, headers={"User-Agent": "Fleet-Tether"})
    with urllib.request.urlopen(request, timeout=60) as response:
        data = response.read(64 * 1024 * 1024 + 1)
    if len(data) > 64 * 1024 * 1024 or digest(data) != checksum:
        raise ValueError("Tether binary checksum verification failed")
    return data


def prerequisites(receipt):
    setup = REPO / "scripts/tether/setup"
    user = pwd.getpwuid(os.getuid())
    fingerprint = digest(setup.read_bytes() + f"{user.pw_uid}:{user.pw_gid}:{user.pw_name}".encode())
    first, last = map(int, Path("/proc/sys/net/ipv4/ping_group_range").read_text().split())
    linger = command(["loginctl", "show-user", str(os.getuid()), "-p", "Linger", "--value"]) == "yes"
    if receipt.get("setup_sha256") != fingerprint or not linger or not first <= os.getgid() <= last:
        print("Configuring Tether's NetworkManager permissions and unattended startup", flush=True)
        check = subprocess.run(["sudo", "-n", "true"], capture_output=True)
        if check.returncode == 0:
            prefix = ["sudo", "-n"]
        else:
            prefix = ["sudo"] if sys.stdin.isatty() else ["pkexec"]
        command([*prefix, "/usr/bin/python3", str(setup), str(os.getuid())])
    return fingerprint


def reconcile(enabled, home):
    unit = home / ".config/systemd/user/tether.service"
    owned = unit.exists() and unit.read_text().startswith(MARKER)
    if not enabled:
        if owned and platform.system() == "Linux":
            systemctl("disable", "--now", "tether.service")
            print("Tether stopped and disabled; configuration and state preserved")
        else:
            print("Tether management disabled")
        return
    if platform.system() != "Linux":
        raise ValueError("Tether requires Linux and NetworkManager; disable it in .fleetrc on this machine")
    if os.getuid() == 0:
        raise ValueError("Run Fleet as your regular user, not root")
    if unit.exists() and not owned:
        raise ValueError(f"Refusing to replace unmanaged unit {unit}")
    config = home / ".config/tether/config.json"
    if not config.is_file():
        raise ValueError("Tether needs ~/.config/tether/config.json; add dotfiles/dot-config/tether/config.json and enable dotfiles")
    pin = json.loads((REPO / "scripts/tether/release.json").read_text())
    arch = {"x86_64": "amd64", "aarch64": "arm64"}.get(platform.machine())
    if arch not in pin["sha256"]:
        raise ValueError(f"Unsupported Tether architecture: {platform.machine()}")
    binary = home / ".local/bin/tether"
    receipt_path = home / ".local/state/fleet/tether/install.json"
    receipt = json.loads(receipt_path.read_text()) if receipt_path.exists() else {}
    if not isinstance(receipt, dict):
        raise ValueError("Invalid Tether installation receipt")
    if binary.exists() and not owned and not receipt:
        raise ValueError(f"Refusing to replace unmanaged binary {binary}")
    fingerprint = prerequisites(receipt)
    changed_binary = not binary.exists() or digest(binary.read_bytes()) != pin["sha256"][arch]
    config_hash = digest(config.read_bytes())
    service = (REPO / "services/tether/tether.service").read_bytes()
    unit_hash = digest(service)
    # Validate both configuration and unprivileged probes before replacing a running binary.
    env = dict(os.environ, XDG_CONFIG_HOME=str(home / ".config"), XDG_STATE_HOME=str(home / ".local/state"))
    if changed_binary:
        url = f"https://github.com/{pin['repo']}/releases/download/{pin['version']}/tether-linux-{arch}"
        data = download(url, pin["sha256"][arch])
        binary.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(prefix=".tether-", dir=binary.parent) as temporary:
            candidate = Path(temporary) / "tether"
            candidate.write_bytes(data)
            candidate.chmod(0o755)
            result = subprocess.run([str(candidate), "-config", str(config), "-check"], env=env, capture_output=True, text=True)
            if result.returncode:
                raise RuntimeError(f"Tether validation failed: {result.stderr.strip()}")
            os.replace(candidate, binary)
    else:
        result = subprocess.run([str(binary), "-config", str(config), "-check"], env=env, capture_output=True, text=True)
        if result.returncode:
            raise RuntimeError(f"Tether validation failed: {result.stderr.strip()}")
    changed_unit = atomic_write(unit, service, 0o644)
    if changed_unit:
        systemctl("daemon-reload")
    changed = changed_binary or changed_unit or receipt.get("config_sha256") != config_hash
    active = subprocess.run(["systemctl", "--user", "is-active", "--quiet", "tether.service"]).returncode == 0
    systemctl("enable", "tether.service")
    if active and changed:
        systemctl("restart", "tether.service")
    elif not active:
        systemctl("start", "tether.service")
    systemctl("is-active", "tether.service")
    installed = {"version": pin["version"], "config_sha256": config_hash, "unit_sha256": unit_hash, "setup_sha256": fingerprint}
    atomic_write(receipt_path, (json.dumps(installed, indent=2) + "\n").encode(), 0o600)
    print(f"Tether {pin['version']} running" + ("; installation updated" if changed else "; unchanged"))


if __name__ == "__main__":
    try:
        reconcile(read_config().get("tether", {}).get("enabled", False), Path.home())
    except (OSError, RuntimeError, ValueError) as error:
        print(f"Tether installation failed: {error}", file=sys.stderr)
        sys.exit(1)
