#!/usr/bin/env python3
"""Sync Fleet-owned Claude settings while preserving local preferences."""

from __future__ import annotations

import json
import os
import sys
import tempfile
from pathlib import Path
from fleet_config import agent_base


def fail(message: str) -> None:
    print(f"FAIL  {message}", file=sys.stderr)
    raise SystemExit(1)


def read_object(path: Path) -> dict[str, object]:
    if not path.exists():
        return {}
    try:
        value = json.loads(path.read_text())
    except json.JSONDecodeError as error:
        fail(f"{path} is invalid JSON: {error}")
    if not isinstance(value, dict):
        fail(f"{path} must contain a JSON object")
    return value


def merge(base: dict[str, object], current: dict[str, object]) -> dict[str, object]:
    merged = dict(current)
    env = merged.get("env")
    if isinstance(env, dict) and env.get("ANTHROPIC_CUSTOM_HEADERS") == "x-opencode-session: claude":
        env = dict(env)
        env.pop("ANTHROPIC_CUSTOM_HEADERS")
        merged["env"] = env
    if "enableArtifact" in base:
        merged.pop("disableArtifact", None)
    overrides = merged.get("modelOverrides")
    if "modelPicker" in base and isinstance(overrides, dict):
        overrides = dict(overrides)
        if overrides.get("claude-opus-5-5") == "gpt-6.1-sol":
            overrides.pop("claude-opus-5-5")
        if overrides:
            merged["modelOverrides"] = overrides
        else:
            merged.pop("modelOverrides", None)
    for key, value in base.items():
        if key in {"env", "permissions"}:
            local_values = merged.get(key, {})
            if not isinstance(local_values, dict):
                fail(f"Claude settings {key} must be a JSON object")
            if not isinstance(value, dict):
                fail(f"Fleet Claude settings {key} must be a JSON object")
            merged[key] = {**local_values, **value}
        else:
            merged[key] = value
    return merged


def sync(base: dict[str, object], target: Path) -> None:
    current = read_object(target)
    merged = merge(base, current)
    content = json.dumps(merged, indent=2, ensure_ascii=False) + "\n"
    if not target.is_symlink() and target.exists() and target.read_text() == content:
        print(f"Unchanged {target}")
        return

    target.parent.mkdir(parents=True, exist_ok=True)
    mode = target.stat().st_mode & 0o777 if target.exists() else 0o600
    descriptor, temporary_name = tempfile.mkstemp(dir=target.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w") as file:
            file.write(content)
        os.chmod(temporary, mode)
        os.replace(temporary, target)
    finally:
        temporary.unlink(missing_ok=True)
    print(f"Updated {target}")


def check(base: dict[str, object], target: Path) -> None:
    if target.is_symlink() or not target.is_file():
        fail(f"{target} must be a machine-local file")
    current = read_object(target)
    if merge(base, current) != current:
        fail(f"{target} does not contain the current Fleet Claude settings")
    print(f"OK    {target}")


def main() -> None:
    if len(sys.argv) != 4 or sys.argv[1] not in {"sync", "check"}:
        fail(f"usage: {Path(sys.argv[0]).name} sync|check BASE TARGET")
    action, base_name, target_name = sys.argv[1:]
    base = json.loads(agent_base(Path(base_name)))
    target = Path(target_name)
    sync(base, target) if action == "sync" else check(base, target)


if __name__ == "__main__":
    main()
