#!/usr/bin/env python3
"""Merge Fleet's MCP servers into machine-local JSON without replacing other state."""

import json
import os
import sys
import tempfile
from pathlib import Path


def main() -> None:
    if len(sys.argv) != 4 or sys.argv[1] not in {"sync", "check"}:
        raise SystemExit(f"usage: {Path(sys.argv[0]).name} sync|check BASE TARGET")
    action, base_name, target_name = sys.argv[1:]
    base = json.loads(Path(base_name).read_text())
    target = Path(target_name)
    current = json.loads(target.read_text()) if target.exists() else {}
    merged = {
        **current,
        "mcpServers": {**current.get("mcpServers", {}), **base["mcpServers"]},
    }
    if action == "check":
        if target.is_symlink() or not target.is_file() or merged != current:
            raise SystemExit(f"FAIL  {target} does not contain the current Fleet MCP config")
        print(f"OK    {target}")
        return
    content = json.dumps(merged, indent=2, ensure_ascii=False) + "\n"
    if not target.is_symlink() and target.exists() and target.read_text() == content:
        print(f"Unchanged {target}")
        return
    target.parent.mkdir(parents=True, exist_ok=True)
    mode = target.stat().st_mode & 0o777 if target.exists() else 0o600
    descriptor, name = tempfile.mkstemp(dir=target.parent)
    temporary = Path(name)
    try:
        with os.fdopen(descriptor, "w") as file:
            file.write(content)
        os.chmod(temporary, mode)
        os.replace(temporary, target)
    finally:
        temporary.unlink(missing_ok=True)
    print(f"Updated {target} from {base_name}")


if __name__ == "__main__":
    main()
