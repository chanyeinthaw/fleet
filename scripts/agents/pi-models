#!/usr/bin/env python3
"""Generate Pi's machine-local model endpoints from Fleet's template."""
import json
import os
from pathlib import Path
import sys
import tempfile
from fleet_config import agent_base

mode, source, destination = sys.argv[1:]
target = Path(destination)
content = json.dumps(json.loads(agent_base(Path(source))), indent=2, ensure_ascii=False) + "\n"
if mode == "check":
    if target.is_symlink() or not target.is_file() or target.read_text() != content:
        sys.exit(f"FAIL  {target} does not match Fleet's local CPA settings")
elif mode == "sync":
    target.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(dir=target.parent)
    with os.fdopen(fd, "w") as file:
        file.write(content)
    os.replace(name, target)
else:
    sys.exit("Expected sync or check")
print(f"OK    {target}")
