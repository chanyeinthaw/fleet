#!/usr/bin/env python3
"""Return Executor authentication headers using Fleet's encrypted secret store."""

import json
import subprocess
from pathlib import Path

token = subprocess.check_output(
    [str(Path.home() / ".local/bin/fleet-fnox"), "-P", "agents", "get", "EXECUTOR_PAT"],
    text=True,
).strip()
print(json.dumps({"Authorization": "Bearer " + token}))
