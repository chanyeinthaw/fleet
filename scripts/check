#!/usr/bin/env bash
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
pi_home="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
codex_home="${CODEX_HOME:-$HOME/.codex}"
claude_home="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
opencode_home="${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}"
failures=0

check_link() {
  local source="$1"
  local target="$2"

  if [[ ! -L "$target" ]]; then
    printf 'FAIL  %s is not a symlink\n' "$target"
    failures=$((failures + 1))
    return
  fi

  if [[ "$(readlink -f "$target")" != "$(readlink -f "$source")" ]]; then
    printf 'FAIL  %s points to %s, expected %s\n' "$target" "$(readlink "$target")" "$source"
    failures=$((failures + 1))
    return
  fi

  printf 'OK    %s\n' "$target"
}

check_absent() {
  local target="$1"

  if [[ -e "$target" || -L "$target" ]]; then
    printf 'FAIL  %s should have been removed\n' "$target"
    failures=$((failures + 1))
    return
  fi

  printf 'OK    %s is absent\n' "$target"
}

check_unmanaged() {
  local source="$1"
  local target="$2"

  if [[ -L "$target" && "$(readlink "$target")" == "$source" ]]; then
    printf 'FAIL  %s should not be linked for this harness\n' "$target"
    failures=$((failures + 1))
    return
  fi

  printf 'OK    %s is not managed by Fleet\n' "$target"
}

check_skills() {
  local harness="$1"
  local target_root="$2"

  for skill in "$repo"/prompts/skills/*; do
    [[ -d "$skill" ]] || continue
    local name
    local harnesses
    name="$(basename "$skill")"
    harnesses="$("$repo/scripts/agents/skill-harnesses" "$skill/SKILL.md")"

    if grep -Fxq "$harness" <<< "$harnesses"; then
      check_link "$skill" "$target_root/$name"
    else
      check_unmanaged "$skill" "$target_root/$name"
    fi
  done

  for target in "$target_root"/*; do
    [[ -L "$target" ]] || continue
    local source
    source="$(readlink "$target")"
    if [[ "$source" == "$repo/prompts/skills/"* && ! -e "$source" ]]; then
      printf 'FAIL  %s points to a removed Fleet skill\n' "$target"
      failures=$((failures + 1))
    fi
  done
}

"$repo/scripts/agents/instructions" check "$repo/prompts/agents/catalog.yaml" pi "$pi_home/AGENTS.md" || failures=$((failures + 1))
check_link "$repo/prompts/references/COMPUTERS.md" "$pi_home/COMPUTERS.md"
check_link "$repo/agents/pi/models.json" "$pi_home/models.json"
check_link "$repo/agents/pi/settings.json" "$pi_home/settings.json"
check_link "$repo/agents/pi/themes" "$pi_home/themes"
check_absent "$pi_home/extensions/subagents.txt"
check_absent "$pi_home/packages"

for extension in "$repo"/agents/pi/extensions/*; do
  [[ -e "$extension" ]] || continue
  check_link "$extension" "$pi_home/extensions/$(basename "$extension")"
done

"$repo/scripts/agents/instructions" check "$repo/prompts/agents/catalog.yaml" codex "$codex_home/AGENTS.md" || failures=$((failures + 1))
"$repo/scripts/agents/codex-config" check "$repo/agents/codex/config.base.toml" "$codex_home/config.toml" || failures=$((failures + 1))
check_link "$repo/agents/codex/subagents" "$codex_home/subagents"
"$repo/scripts/agents/instructions" check "$repo/prompts/agents/catalog.yaml" claude "$claude_home/CLAUDE.md" || failures=$((failures + 1))
check_link "$repo/prompts/references/COMPUTERS.md" "$claude_home/COMPUTERS.md"
"$repo/scripts/agents/claude-config" check "$repo/agents/claude/settings.base.json" "$claude_home/settings.json" || failures=$((failures + 1))

check_skills pi "$pi_home/skills"
check_skills codex "$codex_home/skills"
check_skills claude "$claude_home/skills"
check_link "$repo/agents/claude/plugins/project-skills" "$claude_home/skills/fleet-project-skills"
for agent in "$repo"/agents/claude/agents/*.md; do
  [[ -e "$agent" ]] || continue
  check_link "$agent" "$claude_home/agents/$(basename "$agent")"
done
check_skills opencode "$opencode_home/skills"

for target in "$codex_home"/*.config.toml; do
  [[ -L "$target" ]] || continue
  source="$(readlink "$target")"
  if [[ "$source" == "$repo/agents/codex/profiles/"* && ! -e "$source" ]]; then
    printf 'FAIL  %s points to a removed Fleet profile\n' "$target"
    failures=$((failures + 1))
  fi
done

check_link "$repo/scripts/secrets/fnox" "$HOME/.local/bin/fleet-fnox"

for command in mise pi codex claude gopass; do
  if command -v "$command" >/dev/null; then
    printf 'OK    %s is installed\n' "$command"
  else
    printf 'FAIL  %s is not installed\n' "$command"
    failures=$((failures + 1))
  fi
done

if [[ ! -d "$codex_home/skills/.system" ]]; then
  printf 'WARN  %s is missing; Codex normally creates its bundled skills here\n' "$codex_home/skills/.system"
fi

"$repo/scripts/secrets/fnox" -P agents daemon status || failures=$((failures + 1))

if (( failures > 0 )); then
  printf '\n%d check(s) failed. Run: mise run link\n' "$failures"
  exit 1
fi

printf '\nFleet configuration is linked correctly.\n'
