#!/usr/bin/env bash
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
pi_home="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
codex_home="${CODEX_HOME:-$HOME/.codex}"
opencode_home="${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}"
backup_root="${XDG_STATE_HOME:-$HOME/.local/state}/fleet/backups/$(date +%Y%m%d-%H%M%S)"

backed_up=false

link_path() {
  local source="$1"
  local target="$2"

  mkdir -p "$(dirname "$target")"

  if [[ -L "$target" && "$(readlink -f "$target")" == "$(readlink -f "$source")" ]]; then
    return
  fi

  if [[ -e "$target" || -L "$target" ]]; then
    local relative="${target#$HOME/}"
    local backup="$backup_root/$relative"
    mkdir -p "$(dirname "$backup")"
    mv "$target" "$backup"
    printf 'Backed up %s to %s\n' "$target" "$backup"
    backed_up=true
  fi

  ln -s "$source" "$target"
  printf 'Linked %s -> %s\n' "$target" "$source"
}

remove_managed_link() {
  local source="$1"
  local target="$2"

  if [[ -L "$target" && "$(readlink "$target")" == "$source" ]]; then
    rm "$target"
    printf 'Removed obsolete link %s\n' "$target"
  fi
}

sync_skills() {
  local harness="$1"
  local target_root="$2"
  mkdir -p "$target_root"

  for skill in "$repo"/prompts/skills/*; do
    [[ -d "$skill" ]] || continue
    local name
    local harnesses
    name="$(basename "$skill")"
    harnesses="$("$repo/scripts/skill-harnesses" "$skill/SKILL.md")"

    if grep -Fxq "$harness" <<< "$harnesses"; then
      link_path "$skill" "$target_root/$name"
    else
      remove_managed_link "$skill" "$target_root/$name"
    fi
  done

  for target in "$target_root"/*; do
    [[ -L "$target" ]] || continue
    local source
    source="$(readlink "$target")"
    if [[ "$source" == "$repo/prompts/skills/"* && ! -e "$source" ]]; then
      rm "$target"
      printf 'Removed obsolete link %s\n' "$target"
    fi
  done
}

mkdir -p "$pi_home" "$codex_home"

remove_managed_link "$repo/agents/pi/extensions/subagents.txt" "$pi_home/extensions/subagents.txt"
remove_managed_link "$repo/agents/pi/packages" "$pi_home/packages"

link_path "$repo/prompts/AGENTS.md" "$pi_home/AGENTS.md"
link_path "$repo/prompts/references/COMPUTERS.md" "$pi_home/COMPUTERS.md"
sync_skills pi "$pi_home/skills"

for path in \
  models.json \
  settings.json \
  package.json \
  pnpm-lock.yaml \
  tsconfig.json \
  .oxfmtrc.json \
  .oxlintrc.json \
  themes \
  src; do
  link_path "$repo/agents/pi/$path" "$pi_home/$path"
done

mkdir -p "$pi_home/extensions"
for extension in "$repo"/agents/pi/extensions/*; do
  [[ -e "$extension" ]] || continue
  link_path "$extension" "$pi_home/extensions/$(basename "$extension")"
done

link_path "$repo/prompts/AGENTS.md" "$codex_home/AGENTS.md"
link_path "$repo/prompts/references/COMPUTERS.md" "$codex_home/COMPUTERS.md"
link_path "$repo/agents/codex/config.toml" "$codex_home/config.toml"
link_path "$repo/agents/codex/subagents" "$codex_home/subagents"
sync_skills codex "$codex_home/skills"

sync_skills opencode "$opencode_home/skills"

for profile in "$repo"/agents/codex/profiles/*.config.toml; do
  [[ -e "$profile" ]] || continue
  link_path "$profile" "$codex_home/$(basename "$profile")"
done

if [[ "$backed_up" == true ]]; then
  printf '\nExisting files were preserved under %s\n' "$backup_root"
fi
