#!/usr/bin/env bash
# Use the same pinned fnox, gopass adapter, and daemon settings for every caller.
set -euo pipefail

repo="$(python3 -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).resolve().parents[2])' "${BASH_SOURCE[0]}")"
export PATH="$repo/scripts/secrets/adapter:$HOME/.local/share/mise/shims:$PATH"
export PASSWORD_STORE_DIR="$repo/secrets"
# Keep fnox's fallback socket directory consistent for macOS service launches.
export TMPDIR=/tmp
cd "$repo"
fnox="$(mise which fnox)"
export FNOX_DAEMON=on

if [[ "${1:-}" == warm ]]; then
  # Resolve profiles separately because services reuse names for different keys.
  profiles="$(python3 - "$repo/fnox.toml" <<'PY'
import sys
import tomllib
from pathlib import Path

config = tomllib.loads(Path(sys.argv[1]).read_text())
if config.get("secrets"):
    print("default")
for profile in config.get("profiles", {}):
    if profile != "default":
        print(profile)
PY
)"
  while IFS= read -r profile; do
    "$fnox" --config "$repo/fnox.toml" -P "$profile" export --all >/dev/null
  done <<< "$profiles"
  printf 'Configured secrets cached in fnox daemon memory\n'
else
  exec "$fnox" --config "$repo/fnox.toml" "$@"
fi
