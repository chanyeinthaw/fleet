#!/usr/bin/env bash
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
export FLEET_SERVICES_DATA_DIR="${FLEET_SERVICES_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/fleet/services}"
state="$FLEET_SERVICES_DATA_DIR/friday-optmem"
mkdir -p -m 700 "$state"
exec 9>"$state/deploy.lock"
flock -n 9 || exit 0
umask 077

case "${1:-update}" in
  configure)
    gopass show --noparsing services/friday-optmem/production-env > "$state/runtime.env.next"
    test -s "$state/runtime.env.next"
    mv "$state/runtime.env.next" "$state/runtime.env"
    { printf 'TUNNEL_TOKEN='; gopass show --noparsing services/friday-optmem/tunnel-token; printf '\n'; } > "$state/tunnel.env.next"
    mv "$state/tunnel.env.next" "$state/tunnel.env"
    exit 0
    ;;
  update) ;;
  *) printf 'Usage: %s configure|update [optmem-vX.Y.Z-nightly.N]\n' "$0" >&2; exit 1 ;;
esac

tag="${2:-}"
if [[ -z "$tag" ]]; then
  tag="$(gh api repos/chanyeinthaw/friday/releases --paginate --jq '.[] | select(.draft == false) | .tag_name' | { grep -E '^optmem-v[0-9]+\.[0-9]+\.[0-9]+(-nightly\.[0-9]+)?$' || true; } | sort -V | tail -1)"
fi
[[ "$tag" =~ ^optmem-v[0-9]+\.[0-9]+\.[0-9]+(-nightly\.[0-9]+)?$ ]] || { printf 'No valid Optmem release found.\n' >&2; exit 1; }
if [[ -f "$state/version" && "$(cat "$state/version")" == "$tag" ]]; then exit 0; fi

temporary="$(mktemp -d "$state/release.XXXXXX")"
trap 'rm -rf "$temporary"' EXIT
gh release download "$tag" --repo chanyeinthaw/friday --pattern IMAGE --dir "$temporary"
image="$(cat "$temporary/IMAGE")"
[[ "$image" =~ ^ghcr.io/chanyeinthaw/friday-optmem@sha256:[a-f0-9]{64}$ ]] || { printf 'Invalid release image digest.\n' >&2; exit 1; }
export OPTMEM_IMAGE="$image"
if ! docker pull "$image"; then
  gh release download "$tag" --repo chanyeinthaw/friday --pattern friday-optmem-linux-x64.tar.gz --pattern SHA256SUMS --dir "$temporary"
  checksum="$(awk '$2 == "friday-optmem-linux-x64.tar.gz" { print $1 }' "$temporary/SHA256SUMS")"
  [[ "$checksum" =~ ^[a-f0-9]{64}$ ]] || { printf 'Invalid binary checksum.\n' >&2; exit 1; }
  (cd "$temporary" && printf '%s  friday-optmem-linux-x64.tar.gz\n' "$checksum" | sha256sum --check --status)
  [[ "$(tar -tzf "$temporary/friday-optmem-linux-x64.tar.gz")" == "friday-optmem" ]] || { printf 'Unexpected archive contents.\n' >&2; exit 1; }
  tar -xzf "$temporary/friday-optmem-linux-x64.tar.gz" --no-same-owner -C "$temporary"
  image="friday-optmem:binary-$checksum"
  docker build --tag "$image" --file "$repo/services/friday-optmem/Dockerfile" "$temporary"
  export OPTMEM_IMAGE="$image"
fi
compose=(docker compose -p fleet-services -f "$repo/services/friday-optmem/compose.yaml")
previous=""
if [[ -f "$state/image" ]]; then previous="$(cat "$state/image")"; fi
# Back up the SQLite database and WAL together while this service is stopped.
if [[ -n "$previous" ]]; then
  "${compose[@]}" stop friday-optmem
  if ! docker run --rm --entrypoint /bin/sh --user 0 -v fleet-services_optmem-data:/data:ro -v "$state":/backup "$previous" -c 'tar -C /data -czf /backup/database-before-update.tar.gz .'; then
    OPTMEM_IMAGE="$previous" "${compose[@]}" up -d --wait --wait-timeout 120 friday-optmem
    printf 'Database backup failed; previous image restarted.\n' >&2
    exit 1
  fi
fi
if ! "${compose[@]}" up -d --wait --wait-timeout 120 friday-optmem friday-optmem-tunnel; then
  if [[ -n "$previous" ]]; then
    "${compose[@]}" stop friday-optmem
    docker run --rm --entrypoint /bin/sh --user 0 -v fleet-services_optmem-data:/data -v "$state":/backup:ro "$previous" -c 'find /data -mindepth 1 -maxdepth 1 -exec rm -rf {} +; tar -C /data -xzf /backup/database-before-update.tar.gz'
    export OPTMEM_IMAGE="$previous"
    "${compose[@]}" up -d --wait --wait-timeout 120 friday-optmem friday-optmem-tunnel
  fi
  printf 'Optmem deployment failed; previous image restored when available.\n' >&2
  exit 1
fi
printf '%s\n' "$image" > "$state/image.next"
printf '%s\n' "$tag" > "$state/version.next"
mv "$state/image.next" "$state/image"
mv "$state/version.next" "$state/version"
printf 'Friday Optmem deployed: %s\n' "$tag"
