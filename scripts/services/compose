#!/usr/bin/env python3
"""Resolve profiles separately before mapping secrets to Compose variables."""

import json
import os
from pathlib import Path
import subprocess
import sys

repo = Path(__file__).resolve().parents[2]
env = os.environ.copy()
env.setdefault("FLEET_SERVICES_DATA_DIR", str(Path(env.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "fleet/services"))
for profile in ("postgres", "cpa1", "cpa2", "newt", "friday"):
    result = subprocess.run(
        [str(repo / "scripts/secrets/fnox"), "-P", profile, "export", "--format", "json"],
        capture_output=True,
    )
    if result.returncode:
        sys.exit(f"Could not resolve the {profile} fnox profile; check GPG access.")
    secrets = json.loads(result.stdout)["secrets"]
    for name, value in secrets.items():
        key = name if profile == "postgres" else f"{profile.upper()}_{name}"
        env[key] = value

os.execvpe("docker", ["docker", "compose", "--file", str(repo / "services/compose.yaml"), *sys.argv[1:]], env)
