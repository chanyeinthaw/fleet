#!/usr/bin/env python3
"""Compose harness-specific AGENTS.md files from the Fleet catalog."""

from __future__ import annotations

import os
import re
import sys
import tempfile
from pathlib import Path


KEY = r"[a-z0-9-]+"
ORDER_ITEM = re.compile(rf"^  - ({KEY})$")
MAPPING_ITEM = re.compile(rf"^  ({KEY}): (\S+)$")


def fail(message: str) -> None:
    print(f"FAIL  {message}", file=sys.stderr)
    raise SystemExit(1)


def parse_catalog(path: Path) -> tuple[list[str], dict[str, str], dict[str, str]]:
    values: dict[str, list[str] | dict[str, str]] = {
        "order": [],
        "sections": {},
        "harness": {},
    }
    current: str | None = None

    for line_number, line in enumerate(path.read_text().splitlines(), start=1):
        if not line or line.startswith("#"):
            continue
        if line in {"order:", "sections:", "harness:"}:
            current = line[:-1]
            continue
        if current == "order" and (match := ORDER_ITEM.fullmatch(line)):
            order = values["order"]
            assert isinstance(order, list)
            order.append(match.group(1))
            continue
        if current in {"sections", "harness"} and (match := MAPPING_ITEM.fullmatch(line)):
            mapping = values[current]
            assert isinstance(mapping, dict)
            mapping[match.group(1)] = match.group(2)
            continue
        fail(f"unsupported catalog syntax at {path}:{line_number}")

    order = values["order"]
    sections = values["sections"]
    harnesses = values["harness"]
    assert isinstance(order, list)
    assert isinstance(sections, dict)
    assert isinstance(harnesses, dict)
    if not order or len(order) != len(set(order)):
        fail("catalog order must contain unique section names")
    if set(order) != {*sections, "harness"}:
        fail("catalog order must contain every section and one harness slot")
    return order, sections, harnesses


def section_path(root: Path, relative: str) -> Path:
    path = (root / relative).resolve()
    try:
        path.relative_to(root.resolve())
    except ValueError:
        fail(f"section path escapes {root}: {relative}")
    if not path.is_file():
        fail(f"section is missing: {path}")
    return path


def render(catalog_path: Path, harness: str) -> str:
    order, sections, harnesses = parse_catalog(catalog_path)
    if harness not in harnesses:
        fail(f"unknown harness: {harness}")

    root = catalog_path.parent
    parts: list[str] = []
    for name in order:
        relative = harnesses[harness] if name == "harness" else sections[name]
        parts.append(section_path(root, relative).read_text().strip())
    return "\n\n".join(parts) + "\n"


def sync(content: str, target: Path) -> None:
    existing = target.read_text() if target.exists() else ""
    if not target.is_symlink() and existing == content:
        print(f"Unchanged {target}")
        return

    target.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(dir=target.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w") as file:
            file.write(content)
        os.chmod(temporary, 0o644)
        os.replace(temporary, target)
    finally:
        temporary.unlink(missing_ok=True)
    print(f"Updated {target}")


def check(content: str, target: Path) -> None:
    if target.is_symlink():
        fail(f"{target} should be a generated file, not a symlink")
    if not target.is_file() or target.read_text() != content:
        fail(f"{target} does not match its Fleet instruction catalog")
    print(f"OK    {target}")


def main() -> None:
    if len(sys.argv) != 5 or sys.argv[1] not in {"sync", "check"}:
        fail(f"usage: {Path(sys.argv[0]).name} sync|check CATALOG HARNESS TARGET")
    action, catalog_name, harness, target_name = sys.argv[1:]
    content = render(Path(catalog_name), harness)
    target = Path(target_name)
    sync(content, target) if action == "sync" else check(content, target)


if __name__ == "__main__":
    main()
